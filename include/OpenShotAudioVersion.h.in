#pragma once

#if defined(_WIN32)
 #if defined(OPENSHOT_AUDIO_BUILD)
  #define OPENSHOT_AUDIO_VERSION_API __declspec(dllexport)
 #else
  #define OPENSHOT_AUDIO_VERSION_API __declspec(dllimport)
 #endif
#else
 #define OPENSHOT_AUDIO_VERSION_API __attribute__((visibility("default")))
#endif

namespace openshot_audio {
    /// Full runtime version, including development suffixes.
    OPENSHOT_AUDIO_VERSION_API const char* GetVersion();
}
